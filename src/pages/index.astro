---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const games = await getAllGames(database);
const categories = await getAllCategories(database);
const publishers = await getAllPublishers(database);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-400" data-testid="filter-result-count" role="status" aria-live="polite">
          Showing {games.length} games
        </p>
      </div>

      <form id="game-filters" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5" data-testid="game-filters">
        <div class="grid gap-6 md:grid-cols-[2fr_1fr]">
          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition-colors hover:border-blue-400 hover:text-slate-100 focus-within:ring-2 focus-within:ring-blue-500">
                  <input
                    class="h-4 w-4 accent-blue-500 focus:ring-2 focus:ring-blue-500"
                    type="checkbox"
                    name="category"
                    value={category.id}
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Filter by publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-200 focus:border-blue-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
        </div>

        <button
          type="button"
          id="reset-game-filters"
          class="mt-5 rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="reset-game-filters"
        >
          Clear filters
        </button>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => (
            <div
              data-game-category={game.category?.id ?? ''}
              data-game-publisher={game.publisher?.id ?? ''}
              data-testid={`game-result-${game.id}`}
            >
              <GameCard game={game} />
            </div>
          ))}
        </div>
      )}

      <div class="hidden" data-testid="no-filter-results" role="status">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#game-filters');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const resetButton = document.querySelector<HTMLButtonElement>('#reset-game-filters');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
  const gameResults = Array.from(document.querySelectorAll<HTMLElement>('[data-testid^="game-result-"]'));

  if (form && publisherFilter && resetButton && resultCount && noResults) {
    const categoryFilters = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));

    const updateUrl = (): void => {
      const url = new URL(window.location.href);
      url.searchParams.delete('category');
      url.searchParams.delete('publisher');

      categoryFilters
        .filter((filter) => filter.checked)
        .forEach((filter) => url.searchParams.append('category', filter.value));

      if (publisherFilter.value) {
        url.searchParams.set('publisher', publisherFilter.value);
      }

      window.history.replaceState({}, '', url);
    };

    const applyFilters = (url: URL): void => {
      const selectedCategories = new Set(url.searchParams.getAll('category'));
      const selectedPublisher = url.searchParams.get('publisher') ?? '';

      categoryFilters.forEach((filter) => {
        filter.checked = selectedCategories.has(filter.value);
      });
      publisherFilter.value = selectedPublisher;

      const visibleResults = gameResults.filter((result) => {
        const categoryMatches =
          selectedCategories.size === 0 || selectedCategories.has(result.dataset.gameCategory ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === result.dataset.gamePublisher;
        const visible = categoryMatches && publisherMatches;

        result.hidden = !visible;
        return visible;
      });

      resultCount.textContent = `Showing ${visibleResults.length} of ${gameResults.length} games`;
      noResults.classList.toggle('hidden', visibleResults.length > 0);
    };

    form.addEventListener('change', () => {
      updateUrl();
      applyFilters(new URL(window.location.href));
    });

    resetButton.addEventListener('click', () => {
      categoryFilters.forEach((filter) => {
        filter.checked = false;
      });
      publisherFilter.value = '';
      updateUrl();
      applyFilters(new URL(window.location.href));
    });

    window.addEventListener('popstate', () => applyFilters(new URL(window.location.href)));
    applyFilters(new URL(window.location.href));
  }
</script>
